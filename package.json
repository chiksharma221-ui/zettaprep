{
  "name": "interviewai-studio",
  "version": "1.0.0",
  "private": true,
  "description": "InterviewAI Studio - multi-agent, voice-first AI technical interview platform",
  "scripts": {
    "dev": "concurrently -n web,gateway -c cyan,magenta \"next dev\" \"tsx watch server/gateway.ts\"",
    "dev:web": "next dev",
    "dev:gateway": "tsx watch server/gateway.ts",
    "build": "prisma generate && next build",
    "start": "concurrently -n web,gateway \"next start\" \"tsx server/gateway.ts\"",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test lib/interview/state-machine.test.ts lib/rag/bm25.test.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:index": "tsx prisma/index-knowledge.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "1.2.12",
    "@ai-sdk/openai": "1.3.24",
    "@monaco-editor/react": "4.6.0",
    "@prisma/client": "5.22.0",
    "ai": "4.3.19",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "diff": "5.2.0",
    "dotenv": "16.4.5",
    "framer-motion": "11.11.17",
    "lucide-react": "0.460.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.3",
    "tailwind-merge": "2.5.4",
    "ws": "8.18.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/diff": "5.2.3",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/ws": "8.5.13",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "monaco-editor": "^0.52.2",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.15",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
