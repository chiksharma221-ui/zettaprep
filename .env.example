# ---------- Database (Supabase Postgres with pgvector, or local docker-compose) ----------
# Supabase: Project Settings -> Database -> Connection string (use the pooled URL for DATABASE_URL
# and the direct URL for DIRECT_URL so Prisma migrations work).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interviewai?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/interviewai?schema=public"

# ---------- OpenAI (Realtime voice + embeddings, and agents when AGENT_PROVIDER=openai) ----------
OPENAI_API_KEY="sk-..."
OPENAI_REALTIME_MODEL="gpt-realtime"
OPENAI_REALTIME_VOICE="marin"
OPENAI_TRANSCRIBE_MODEL="gpt-4o-mini-transcribe"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ---------- Text agents (Cross-Examiner, Critic, Hint, Arena) ----------
# "anthropic" or "openai"
AGENT_PROVIDER="anthropic"
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-5-5"
OPENAI_AGENT_MODEL="gpt-4.1"

# ---------- Code execution (Judge0 CE self-hosted or RapidAPI) ----------
JUDGE0_URL="https://judge0-ce.p.rapidapi.com"
JUDGE0_API_KEY=""            # RapidAPI key; leave empty for a self-hosted instance
JUDGE0_API_HOST="judge0-ce.p.rapidapi.com"

# ---------- Realtime gateway ----------
GATEWAY_PORT=3001
NEXT_PUBLIC_GATEWAY_URL="ws://localhost:3001"
# Shared secret the Next.js app uses to sign short-lived gateway tickets
GATEWAY_SECRET="change-me-to-a-long-random-string"
